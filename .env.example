# Rage AI web app
NEXT_PUBLIC_RAGE_API_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=wiseiodev

# Neon Postgres. Use the pooled Neon connection string for Vercel/serverless.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/rageai?sslmode=require

# Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only HMAC secret for install/IP anti-abuse buckets.
RAGE_HMAC_SECRET=replace-with-openssl-rand-base64-32

# Vercel Firewall rate-limit IDs configured manually in the Vercel dashboard.
VERCEL_WAF_AUTH_RATE_LIMIT_ID=rage-auth
VERCEL_WAF_PUBLISH_RATE_LIMIT_ID=rage-publish
VERCEL_WAF_LEADERBOARD_RATE_LIMIT_ID=rage-leaderboard
VERCEL_WAF_ADMIN_RATE_LIMIT_ID=rage-admin
