{
  "name": "@rageai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('No db unit tests yet')\"",
    "generate": "node --env-file-if-exists=../../apps/web/.env node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "node --env-file-if-exists=../../apps/web/.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "latest",
    "typescript": "catalog:",
    "vitest": "4.1.8"
  }
}
